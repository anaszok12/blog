---
// The /blog/tags/ page: every tag with its post count.
import Base from '../../../layouts/Base.astro';
import TagList from '../../../components/TagList.astro';
import Label from '../../../components/Label.astro';
import { getPosts, getTags } from '../../../utils/posts';
const tags = getTags(await getPosts());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Tags" description="Browse blog posts by tag.">
  <a href={`${base}/blog/`} class="font-mono text-sm text-dim hover:text-accent">← all posts</a>
  <div class="mt-8"><Label n="01" text="tags" /></div>
  <h1 class="mt-2 text-4xl font-bold sm:text-5xl">Tags</h1>
  <p class="mt-4 text-lg">Pick a topic to see every post about it.</p>
  <div class="mt-8">
    {tags.length > 0 ? <TagList tags={tags} /> : <p class="text-dim">No tags yet.</p>}
  </div>
</Base>

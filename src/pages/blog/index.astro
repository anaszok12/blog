---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Label from '../../components/Label.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog">
  <Label n="01" text="blog" />
  <h1 class="mt-2 text-4xl font-bold sm:text-5xl">All posts</h1>
  <p class="mt-4 text-lg">BIM, content management and structural engineering notes, newest first.</p>
  <div class="mt-10"><PostList posts={posts} /></div>
</Base>

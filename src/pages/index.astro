---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Label from '../components/Label.astro';
import { SITE } from '../config';
import Icon from '../components/Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---
<Base>
  <!-- Intro -->
  <section>
    <div class="flex items-center gap-4">
      <div class="grid size-16 shrink-0 place-items-center rounded-full border-2 border-accent/40 bg-card font-mono text-lg font-bold text-fg sm:size-20 sm:text-xl">{SITE.initials}</div>
      <div>
        <p class="text-2xl font-semibold text-fg sm:text-3xl">{SITE.name}</p>
        <p class="font-mono text-sm text-dim">{SITE.role}</p>
      </div>
    </div>

    <h1 class="mt-8 text-4xl font-bold sm:text-5xl">
      Notes on BIM, content management and <span class="text-accent underline decoration-accent/50 decoration-2 underline-offset-8">structural engineering</span>.
    </h1>
    <p class="mt-6 text-lg">
      I'm a structural and BIM engineer.
      Here I write about <span class="text-fg">BIM</span>, <span class="text-fg">content management</span> and <span class="text-fg">structural engineering</span>.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href={`${base}/blog/`} class="inline-flex items-center gap-2 rounded-lg bg-fg px-5 py-2.5 font-medium text-bg hover:bg-white">Read the blog <span aria-hidden="true">→</span></a>
      <a href={`${base}/contact/`} class="text-dim hover:text-fg">Get in touch</a>
      <span class="flex items-center gap-1">
        {SITE.socials.map((s) => (
          <a href={s.url} rel="me noopener" target="_blank" aria-label={s.label} class="grid size-10 place-items-center rounded-lg text-dim transition-colors hover:bg-white/5 hover:text-accent"><Icon name={s.name} /></a>
        ))}
      </span>
    </div>
  </section>

  <!-- Latest posts -->
  <section class="mt-20">
    <Label n="01" text="writing" />
    <div class="mt-2 flex items-end justify-between gap-4">
      <h2 class="text-2xl font-semibold">Latest posts</h2>
      <a href={`${base}/blog/`} class="shrink-0 text-sm text-dim hover:text-fg">all posts →</a>
    </div>
    <div class="mt-6"><PostList posts={posts} /></div>
  </section>

  <!-- Topics -->
  <section class="mt-20">
    <Label n="02" text="topics" />
    <h2 class="mt-2 text-2xl font-semibold">What I write about</h2>
    <ul class="mt-6 flex flex-wrap gap-2">
      {SITE.topics.map((t) => <li class="rounded-md border border-line bg-card px-3 py-1 font-mono text-sm text-soft">{t}</li>)}
    </ul>
  </section>

  <!-- Tools -->
  <section class="mt-20">
    <Label n="03" text="tools" />
    <h2 class="mt-2 text-2xl font-semibold">Tools I use</h2>
    <ul class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3">
      {SITE.tools.map((t) => <li class="bg-card px-5 py-4 font-medium text-fg">{t}</li>)}
    </ul>
  </section>

  <!-- Contact -->
  <section class="mt-20">
    <Label n="04" text="contact" />
    <h2 class="mt-2 text-2xl font-semibold">Say hello</h2>
    <p class="mt-3">Questions about BIM, content management or structural engineering? Email <a href={`mailto:${SITE.email}`} class="ul break-all">{SITE.email}</a>.</p>
  </section>
</Base>

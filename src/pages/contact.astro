---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
import { SITE } from '../config';
---
<Base title="Contact">
  <Label n="01" text="contact" />
  <h1 class="mt-2 text-4xl font-bold sm:text-5xl">Get in touch</h1>
  <p class="mt-4 text-lg">Questions about BIM, content management or structural engineering? I read every email.</p>
  <ul class="mt-10 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-card/60">
    <li><a href={`mailto:${SITE.email}`} class="group flex items-center justify-between gap-4 p-5 hover:bg-white/[0.03]">
      <span><span class="block font-mono text-xs text-dim">email</span><span class="break-all text-fg group-hover:text-accent">{SITE.email}</span></span><span class="text-dim" aria-hidden="true">→</span></a></li>
    <li><a href={SITE.github} class="group flex items-center justify-between gap-4 p-5 hover:bg-white/[0.03]">
      <span><span class="block font-mono text-xs text-dim">github</span><span class="text-fg group-hover:text-accent">{SITE.github.replace('https://', '')}</span></span><span class="text-dim" aria-hidden="true">→</span></a></li>
  </ul>
</Base>

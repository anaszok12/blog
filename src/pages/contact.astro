---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---
<Base title="Contact">
  <h1 class="mb-6 text-3xl font-bold">Contact</h1>
  <p class="mb-4">Questions about BIM, Revit or precast? Get in touch.</p>
  <ul class="space-y-2">
    <li>Email: <a href={`mailto:${SITE.email}`} class="text-blue-600 hover:underline dark:text-blue-400">{SITE.email}</a></li>
    <li>GitHub: <a href={SITE.github} class="text-blue-600 hover:underline dark:text-blue-400">{SITE.github.replace('https://', '')}</a></li>
  </ul>
</Base>

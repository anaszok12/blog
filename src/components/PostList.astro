---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-card/60">
  {posts.map((post) => (
    <li>
      <a href={`${base}/blog/${post.id}`} class="group flex items-start gap-4 p-5 transition-colors hover:bg-white/[0.03] sm:p-6">
        <div class="min-w-0 flex-1">
          <h3 class="text-lg font-semibold group-hover:text-accent">{post.data.title}</h3>
          {post.data.description && <p class="mt-1 text-[0.95rem] text-dim">{post.data.description}</p>}
          <p class="mt-2 font-mono text-xs text-dim">{fmt(post.data.date)}</p>
        </div>
        <span class="mt-1 text-dim transition-transform group-hover:translate-x-0.5 group-hover:text-accent" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
  {posts.length === 0 && <li class="p-6 text-dim">No posts yet.</li>}
</ul>

---
import '../styles/global.css';
import { SITE } from '../config';

interface Props { title?: string; description?: string; pattern?: boolean }
// pattern: show the dotted background (turned off on post pages for easier reading)
const { title, description = SITE.description, pattern = true } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { href: `${base}/blog`, label: 'Blog', active: path.startsWith(`${base}/blog`) },
  { href: `${base}/contact`, label: 'Contact', active: path === `${base}/contact` },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#18181b" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-dvh" id="top">
    {pattern && <div class="pattern" aria-hidden="true"></div>}

    <header class="sticky top-0 z-10 border-b border-line bg-bg/85 pt-[env(safe-area-inset-top)] backdrop-blur-md">
      <div class="mx-auto flex h-14 max-w-3xl items-center justify-between gap-4 px-5">
        <a href={`${base}/`} class="flex items-center gap-2.5 font-semibold text-fg">
          <span class="grid size-7 place-items-center rounded-md bg-fg font-mono text-[0.7rem] font-bold text-bg">{SITE.initials}</span>
          {SITE.title}
        </a>
        <nav class="flex items-center gap-1 text-[0.95rem]">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.active ? 'page' : undefined}
               class:list={['rounded-md px-3 py-1.5 transition-colors', n.active ? 'text-fg' : 'text-dim hover:text-fg']}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl px-5 py-12 sm:py-16">
      <slot />
    </main>

    <footer class="mx-auto max-w-3xl px-5 pb-[max(2.5rem,env(safe-area-inset-bottom))]">
      <div class="border-t border-line pt-6 text-sm text-dim">
        <p class="font-mono text-xs">BIM · content management · structural engineering</p>
        <p class="mt-2">
          © {new Date().getFullYear()} {SITE.author}{' · '}
          <a href={SITE.github} class="text-fg hover:text-accent">GitHub</a>{' · '}
          <a href="#top" class="text-fg hover:text-accent">Back to top</a>
        </p>
      </div>
    </footer>
  </body>
</html>

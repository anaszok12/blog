---
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { href: `${base}/`, label: 'Home', active: path === base },
  { href: `${base}/blog`, label: 'Blog', active: path.startsWith(`${base}/blog`) && path !== base },
  { href: `${base}/contact`, label: 'Contact', active: path === `${base}/contact` },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c1c1e" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-dvh">
    <div class="backdrop" aria-hidden="true"><span></span><span></span><span></span></div>

    <header class="sticky top-0 z-10 px-4 pt-[max(0.75rem,env(safe-area-inset-top))]">
      <div class="glass glass-nav mx-auto flex max-w-2xl items-center justify-between gap-3 rounded-full py-2 pr-2 pl-5">
        <a href={`${base}/`} class="font-display text-lg font-semibold tracking-tight">{SITE.title}</a>
        <nav class="flex gap-1 text-[0.95rem]">
          {nav.map((n) => (
            <a
              href={n.href}
              aria-current={n.active ? 'page' : undefined}
              class:list={[
                'rounded-full px-3 py-1.5 transition-colors',
                n.active ? 'bg-white/15 text-white' : 'text-zinc-300 hover:bg-white/10',
              ]}
            >{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-2xl px-5 py-10 sm:py-14">
      <slot />
    </main>

    <footer class="mx-auto max-w-2xl px-5 pb-[max(2rem,env(safe-area-inset-bottom))] text-base text-zinc-400">
      <div class="border-t border-white/10 pt-6">
        © {new Date().getFullYear()} {SITE.author} ·
        <a href={SITE.github} class="underline decoration-white/20 underline-offset-4 hover:text-white">GitHub</a>
      </div>
    </footer>
  </body>
</html>
